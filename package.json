{
  "name": "compile-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:mcp": "npm run dev -w @compile/mcp-server",
    "dev:ui": "npm run dev -w @compile/ui",
    "demo": "npm run prewarm:ui && npm run dev:ui",
    "snapshot": "npm run snapshot -w @compile/ui",
    "harness": "npm run harness -w @compile/synthesizer",
    "warm": "npm run build -w @compile/runtime && npm run warm -w @compile/runtime",
    "prewarm:ui": "npm run build -w @compile/nia && npm run build -w @compile/runtime && npm run prewarm:ui -w @compile/runtime",
    "bench": "npm run build -w @compile/synth-loader && npm run bench -w @compile/synth-loader",
    "daemon:fake": "node scripts/serve-fake-daemon.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "convex": "^1.38.0"
  }
}
