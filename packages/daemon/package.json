{
  "name": "@compile/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file=../../.env.local --import tsx src/index.ts",
    "start": "node --env-file=../../.env.local ./dist/index.js"
  },
  "dependencies": {
    "@compile/nia": "*",
    "@compile/runtime": "*",
    "@compile/scanner": "*",
    "@compile/schemas": "*",
    "@compile/stream": "*",
    "@compile/synth-loader": "*",
    "@compile/synthesizer": "*",
    "convex": "^1.38.0"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "vitest": "^2.1.4"
  }
}
