{
  "name": "@compile/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "derisk:phi": "tsx src/phi/derisk.ts",
    "generate:inputs": "tsx src/inputs/cli.ts",
    "warm": "node ./dist/warm-cli.js",
    "live-smoke": "node --env-file=../../.env.local ./dist/tensorlake-smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@compile/schemas": "*",
    "esbuild": "^0.24.0",
    "tensorlake": "^0.5.9"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "vitest": "^2.1.4"
  }
}
